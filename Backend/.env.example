# ============================================================
# POWER HOUSE MULTI GYM - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================
# IMPORTANT: All variables in this file are BACKEND ONLY.
# NEVER expose DB, CLOUD_SEC, JWT_SEC, or owner credentials to React or browser clients.

# MongoDB Connection URI
DB=mongodb+srv://<username>:<password>@cluster.mongodb.net/gym_db

# Cloudinary Storage Configuration
CLOUD_ID=your_cloudinary_cloud_id
CLOUD_KEY=your_cloudinary_api_key
CLOUD_SEC=your_cloudinary_api_secret

# Secret Key for Signing JSON Web Tokens
JWT_SEC=your_super_secret_jwt_key_here

# Initial Gym Owner Account Credentials (Seeded into MongoDB as bcrypt hash)
GYM_OWNER_ID=power house multi gym
GYM_OWNER_PASSWORD=your_secure_owner_password_here

# Frontend Application Client URL (For CORS Credentials)
CLIENT_URL=http://localhost:5173
